{
  "name": "TeeChart",
  "version": "0.0.1",
  "description": "Creates Charts from data found in the current web page.",
  "icons": { "128": "icon.png" },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["http://*/*", "file://*/*"], "js": ["teechart_content_script.js"] }
  ],
  "permissions": [
    "tabs"
  ],
  "page_action": {
      "default_name": "Display Chart",
      "default_icon": "chart.png",
      "default_popup": "popup.html"
  },
  "manifest_version": 2,
  "content_security_policy": "default-src 'none'; style-src 'self'; script-src 'self' https://www.steema.com;"
}
